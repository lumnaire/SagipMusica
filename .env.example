# Copy to .env and fill in from your Supabase project
# (Project Settings > API). Both values are safe to expose in the browser --
# the publishable/anon key is public by design, and Row Level Security is what
# actually protects your data. Never put a service_role or secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
